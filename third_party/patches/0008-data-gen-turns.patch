+# Base problem and turn (0-7) of sample idx; turns > 1 needs lib/turns.py
+def split_idx(idx: int, data_args: Dict) -> Tuple[int, int]:
+    num_turns: int = data_args["turns"]
+    if num_turns == 1:
+        return (idx, 0)
+    from turns import sample_turn
+
+    return sample_turn(idx, data_args["batch"] // num_turns, num_turns)
+
+
+# Turned copies only work on a square box whose shared tree mirrors onto itself
+def check_turns(data_args: Dict) -> None:
+    num_turns: int = data_args["turns"]
+    assert 1 <= num_turns <= 8, f"turns must be 1-8: {num_turns}"
+    if num_turns == 1:
+        return
+    assert data_args["batch"] % num_turns == 0, "batch must be a multiple of turns"
+    assert data_args["x_range"] == data_args["y_range"], "turns needs a square box"
+    assert data_args["constraint"] in ("level", None), "turns needs level or no constraint"
+    if data_args["constraint"] == "level":
+        assert data_args["x_range"] % 2 ** data_args["level"] == 0, (
+            "turns needs whole-number cell edges"
+        )
+
+

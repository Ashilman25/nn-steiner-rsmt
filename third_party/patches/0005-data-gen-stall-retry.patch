+# GeoSteiner (built without CPLEX) can stall forever on rare point sets.
+# If no sample finishes for this long, stuck samples are redone with new points.
+STALL_SECONDS: int = 120
+MAX_ATTEMPTS: int = 5
+RETRY_SEED_OFFSET: int = 10_000_000
+
 

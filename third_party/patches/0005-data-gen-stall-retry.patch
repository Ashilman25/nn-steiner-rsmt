-        data_args["dist"], data_args, idx + data_args["seed"]
-    )
+    attempt: int = 0,
+) -> Tuple[int, int]:
+    # point generation (a retry after a stall gets a fresh point set)
+    seed: int = idx + data_args["seed"] + attempt * RETRY_SEED_OFFSET
+    point_gen: PointGen = get_pointGen(data_args["dist"], data_args, seed)
     points: List[Tuple[int, int]] = point_gen.get_points(data_args["num_points"])
 
